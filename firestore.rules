rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // USERS - Public read (for leaderboard + profiles), private write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // PROJECTS (parent projects)
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // SUBPROJECTS - public read needed for leaderboard + marketplace (guest browsing)
    match /subprojects/{subprojectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.posterUid == request.auth.uid
      );

      // Once a dispute is open the record is frozen to all clients.
      // Arbitration reads submissions as evidence — neither party may edit it.
      // Server-side writes use the Admin SDK and bypass these rules.
      allow update: if request.auth != null
        && resource.data.disputeFiled != true
        && (
          // Poster / owner may update their own posting
          resource.data.ownerUid == request.auth.uid ||
          resource.data.posterUid == request.auth.uid ||

          // Accepted builder may only touch delivery and dispute fields
          (resource.data.acceptedBidderUid == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'submissions', 'reviews', 'status',
             'disputeFiled', 'disputeFiledBy', 'disputeFiledAt', 'disputeReason'
           ])) ||

          // Anyone signed in may append a bid while bidding is open
          (resource.data.bidsOpen == true &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bids']))
        );
    }
    // COMPANIES - public read needed for marketplace browsing
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    // REVIEWS - public read needed for leaderboard ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // EQUITY LISTINGS - public read needed for marketplace browsing
    match /equityListings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.sellerUid == request.auth.uid;
    }
    // EQUITY HOLDERS — public read for cap table view, authenticated write
    match /equityHolders/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // POSTS (Ideas & News) - public read for explore tab browsing
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
    // PLATFORM STATS - public read needed for marketplace stats
    match /platformStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // CHATS
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
                           (request.auth.uid in resource.data.participants ||
                            request.auth.uid in request.resource.data.participants);
    }
    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow create: if request.auth != null;
    }
    // EQUITY STAKES — read only for users, written only by Cloud Functions
    match /equityStakes/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // REWARD DISTRIBUTIONS — users can only read their own
    match /rewardDistributions/{docId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2'
      );
      allow write: if false;
    }
    // PROTOCOL FEES — authenticated users can create, nobody can read/edit
    match /protocolFees/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    // CONFIG — read only from frontend, write only via console
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // SECURITY LOGS — admin only via Firebase console
    match /securityLogs/{logId} {
      allow read: if false;
      allow write: if request.auth != null;
    }
    // FOLLOWS — public read for follow counts on profiles
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }
		// BOOKMARKS — users can only read/write their own
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null && (
        !exists(/databases/$(database)/documents/bookmarks/$(bookmarkId)) ||
        resource.data.uid == request.auth.uid
      );
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    // FLOWMAPS — owner only
    match /flowMaps/{flowMapId} {
      allow read, write: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null;
    }
    // DATA ROOM — founder controls access via approvedViewers list
    match /dataRooms/{companyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // AD CAMPAIGNS — public read for active ads, authenticated write
    match /adCampaigns/{campaignId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.advertiserUid == request.auth.uid;
    }
    match /equityOffers/{offerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.buyerUid == request.auth.uid;
    }
    // SUPPORT TICKETS — users read/write their own, admin reads all
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2'
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2'
      );
    }
  }
}
