rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // TWO RULES OF THUMB IN THIS FILE
    //
    // 1. resource.data.get(field, default)
    //    Reading a field that does not exist on a document THROWS and denies
    //    the operation. Always use .get() for any field that may be absent.
    //
    // 2. resource == null
    //    When a document does not exist, `resource` itself is null, so even
    //    .get() throws. Any path that reads a document before creating it
    //    needs an explicit null guard.
    // ─────────────────────────────────────────────────────────────────────

    // USERS — public read for leaderboard and profiles, private write
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // PROJECTS (parent projects)
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // SUBPROJECTS — public read for leaderboard and guest marketplace browsing
    match /subprojects/{subprojectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.get('ownerUid', '')  == request.auth.uid ||
        resource.data.get('posterUid', '') == request.auth.uid
      );

      // Once a dispute is open the record is frozen to all clients.
      // Arbitration reads submissions as evidence — neither party may edit it.
      // Server-side writes use the Admin SDK and bypass these rules.
      allow update: if request.auth != null
        && resource.data.get('disputeFiled', false) != true
        && (
          // Poster / owner may update their own posting
          resource.data.get('ownerUid', '')  == request.auth.uid ||
          resource.data.get('posterUid', '') == request.auth.uid ||

          // Accepted builder may only touch delivery and dispute fields
          (resource.data.get('acceptedBidderUid', '') == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'submissions', 'reviews', 'status',
             'disputeFiled', 'disputeFiledBy', 'disputeFiledAt', 'disputeReason'
           ])) ||

          // Anyone signed in may append a bid while bidding is open
          (resource.data.get('bidsOpen', false) == true &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bids']))
        );
    }

    // COMPANIES — public read for marketplace browsing
    match /companies/{companyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // REVIEWS — public read for leaderboard ratings, immutable once written
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // EQUITY LISTINGS — public read for marketplace browsing.
    // Seller controls the listing; a buyer may only claim and complete it.
    match /equityListings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.get('sellerUid', '') == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active', 'status', 'soldAt',
          'acquisitionPending', 'buyerAddress', 'buyerUid',
          'buyerUsername', 'buyerName'
        ])
      );
      allow delete: if request.auth != null
        && resource.data.get('sellerUid', '') == request.auth.uid;
    }

    // EQUITY OFFERS — buyer or the listing's seller may change an offer.
    // exists() guard: get() on a missing listing returns null and would throw.
    match /equityOffers/{offerId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.get('buyerUid', '') == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.get('buyerUid', '') == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/equityListings/$(resource.data.get('listingId', '__none__'))) &&
          get(/databases/$(database)/documents/equityListings/$(resource.data.get('listingId', '__none__')))
            .data.get('sellerUid', '') == request.auth.uid
        )
      );
      allow delete: if request.auth != null
        && resource.data.get('buyerUid', '') == request.auth.uid;
    }

    // EQUITY HOLDERS — cap table index. Public read (cap tables are public).
    // The chain is authoritative: the display reads balances() on V4 and only
    // uses this collection to know WHICH wallets to look up. Writes are
    // therefore low-value to an attacker, but deletes would hide real holders,
    // so deletes are admin-only.
    // Paid AI jobs. Written only by the server (admin SDK bypasses rules) —
    // a client that could write here could mark its own job done, or flip a
    // job to failed to trigger a refund it is not owed.
    match /aiJobs/{jobId} {
      allow read:  if request.auth != null
                   && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /equityHolders/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2';
    }

    // VOUCHERS — server-only. Burns a payment txHash so it cannot be reused.
    match /vouchers/{txHash} {
      allow read, write: if false;
    }

    // POSTS (Ideas & News) — public read. Author may edit their own post;
    // anyone signed in may like, comment, or sponsor-boost.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.get('posterUid', '') == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likedBy', 'comments',
          'isSponsoredBoost', 'sponsoredBoostUntil', 'lastBoostedAt'
        ])
      );
      allow delete: if request.auth != null
        && resource.data.get('posterUid', '') == request.auth.uid;
    }

    // PLATFORM STATS — public read, server-written only
    match /platformStats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // CHATS — participants only
    match /chats/{chatId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid in request.resource.data.get('participants', [])
      );
    }

    // NOTIFICATIONS — recipient reads and marks read; anyone may create,
    // since both parties notify each other through a bounty lifecycle.
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
        && request.auth.uid == resource.data.get('recipientUid', '');
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.get('recipientUid', '');
    }

    // EQUITY STAKES — server-written only
    match /equityStakes/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // REWARD DISTRIBUTIONS — users read only their own
    match /rewardDistributions/{docId} {
      allow read: if request.auth != null && (
        resource.data.get('uid', '') == request.auth.uid ||
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2'
      );
      allow write: if false;
    }

    // PROTOCOL FEES — clients record a fee, nobody reads or edits.
    // NOT trusted for payment verification — claim-voucher.js reads the chain.
    match /protocolFees/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // CONFIG — read only from the frontend, write only via console
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // SECURITY LOGS — append-only from clients, admin reads via console
    match /securityLogs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ERROR LOG — clients write failures, digest cron reads via Admin SDK
    match /errorLog/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // FOLLOWS — public read for follow counts on profiles
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.get('followerUid', '') == request.auth.uid;
      allow update: if false;
    }

    // BOOKMARKS — users read and write only their own.
    // toggleBookmark reads before writing, so a missing doc must be readable.
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.get('uid', '') == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.get('uid', '') == request.auth.uid;
    }

    // FLOWMAPS — owner only
    match /flowMaps/{flowMapId} {
      allow read, update, delete: if request.auth != null
        && resource.data.get('ownerUid', '') == request.auth.uid;
      allow create: if request.auth != null;
    }

    // DATA ROOM — confidential founder documents.
    // Read: company owner or an approved viewer. Write: company owner only.
    // The null guard matters — the UI reads the room before one is created.
    match /dataRooms/{companyId} {
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid in resource.data.get('approvedViewers', []) ||
        (
          exists(/databases/$(database)/documents/companies/$(companyId)) &&
          get(/databases/$(database)/documents/companies/$(companyId))
            .data.get('ownerUid', '') == request.auth.uid
        )
      );
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId))
             .data.get('ownerUid', '') == request.auth.uid;
    }

    // AD CAMPAIGNS — public read for active ads
    match /adCampaigns/{campaignId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Advertiser manages their own campaign
        resource.data.get('advertiserUid', '') == request.auth.uid ||
        // Admin approves or rejects
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2' ||
        // Any viewer may increment impression and click counters
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['impressions', 'clicks'])
      );
      allow delete: if request.auth != null
        && resource.data.get('advertiserUid', '') == request.auth.uid;
    }

    // SUPPORT TICKETS — users read and write their own, admin reads all.
    // The admin branch does not depend on document fields, so the admin's
    // unfiltered status query is satisfiable while a user's is not.
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null && (
        resource.data.get('uid', '') == request.auth.uid ||
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2'
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.get('uid', '') == request.auth.uid ||
        request.auth.uid == '5t0gD2wVnqXXPAQEzfoahx3EIPp2'
      );
    }
  }
}
